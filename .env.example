# Google Cloud (Vertex AI)
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=asia-northeast3       # Vertex AI 리전 (서울)
GEMINI_MODEL=gemini-2.5-flash    # 사용할 Gemini 모델

# 한국투자증권 API
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCOUNT_NO=00000000-00  # 계좌번호 (앞8자리-뒤2자리)
KIS_MOCK=true               # true = 모의투자, false = 실계좌

# 트레이딩 설정
MAX_POSITIONS=5             # 최대 보유 종목 수
TAKE_PROFIT_PCT=4.0         # 익절 기준 (%)
STOP_LOSS_PCT=2.5           # 손절 기준 (%)

# 로컬 실행 방법 (Cloud Run 환경은 서비스 계정 ADC 자동 사용)
# gcloud auth application-default login  # 로컬 개발 시 인증
# pip install -r requirements.txt
# python main.py --once              # 에이전트 1회 실행
# streamlit run dashboard/app.py     # 대시보드 실행 (localhost:8501)
