# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# 한국투자증권 모의투자 API
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCOUNT_NO=00000000-00  # 계좌번호 (앞8자리-뒤2자리)
KIS_MOCK=true               # true = 모의투자, false = 실계좌

# 트레이딩 설정
MAX_BUY_AMOUNT=500000       # 1회 최대 매수금액 (원)
MAX_POSITIONS=5             # 최대 보유 종목 수

# 실행 방법
# pip install -r requirements.txt
# python main.py --once              # 에이전트 1회 실행
# python main.py                     # 09:10, 14:00 자동 스케줄
# streamlit run dashboard/app.py     # 대시보드 실행 (localhost:8501)
